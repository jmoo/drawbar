# Per-field decode over every .ne5s in the corpus: where each field sits and
# every value the corpus has been seen to put there. A field listing one value
# is a field the corpus cannot check.

rotary_ctrl_type
  at      52..=53
  raw     3    [0, 1, 2]
  decoded 3    [Closed, HalfMoon, Open]

