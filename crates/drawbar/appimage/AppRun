#!/bin/sh
# Runs drawbar through the loader beside it, on the libraries beside it, so it needs no
# library from the host. The loader passes the path to drawbar alone, not its children.
set -eu

here=$(dirname "$(readlink -f "$0")")

# glvnd would otherwise also try the host's GL vendors, which need the host's libraries.
export __EGL_VENDOR_LIBRARY_FILENAMES="$here/usr/share/glvnd/egl_vendor.d/50_mesa.json"
export __GLX_VENDOR_LIBRARY_NAME=mesa

export ALSA_CONFIG_DIR="$here/usr/share/alsa"
export ALSA_PLUGIN_DIR="$here/usr/lib"
# PipeWire's PulseAudio server answers here too.
if [ -n "${PULSE_SERVER:-}" ] || [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/pulse/native" ]; then
	export ALSA_CONFIG_PATH="$ALSA_CONFIG_DIR/alsa.conf:$ALSA_CONFIG_DIR/99-pulseaudio-default.conf"
fi

exec "$here/usr/lib/@interpreter@" --library-path "$here/usr/lib" --argv0 drawbar \
	"$here/usr/bin/drawbar" "$@"
