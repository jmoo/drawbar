# source: synthetic
# note: 0x11 is the instrument refusing a cursor request. A walk that treated it
#   like the end-of-walk status would return an inventory that looks complete,
#   which is the one result worse than none. The closing exchanges are here, so
#   the refusal must still run them.
# intent: program walk
# expect: err device-status 0x11
O 0000001200000006000000010000000006a1
I 000000160000000600000001000000010000000044ec
O 000000160000000c0000000a0000000400000004a218
I 0000001a0000000c0000000a00000005000000000000000467b0
O 0000001e0000000c0000000a0000002000000000ffffffff000000002b7f  # the first bank, from its boundary
I 000000160000000c0000000a0000002100000011cb6f  # refused 0x11, and the walk stops there
O 000000120000000c0000000a000000066500
I 000000160000000c0000000a00000007000000000c4e
O 0000001200000006000000010000000226e3
I 0000001600000006000000010000000300000000006f
